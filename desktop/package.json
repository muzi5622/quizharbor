{
  "name": "quizharbor-desktop",
  "productName": "QuizHarbor",
  "version": "0.2.0",
  "description": "QuizHarbor host app for Windows. Players join from their phone browser by QR code or PIN.",
  "author": "MUZI",
  "license": "MIT",
  "private": true,
  "main": "app/main.cjs",
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "start": "npm run stage && electron .",
    "dist": "npm run stage && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.muzi.quizharbor",
    "productName": "QuizHarbor",
    "copyright": "Made by MUZI",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["app/**/*", "package.json"],
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": ["**/*.node"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "QuizHarbor",
      "runAfterFinish": true,
      "artifactName": "QuizHarbor-Setup-${version}.exe"
    }
  }
}
